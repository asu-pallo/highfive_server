# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#
#   cp .env.example .env

# 필수. 운영에서는 반드시 바꾼다.
# 생성: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-only-insecure-key

# True 면 개발 모드. 운영에서는 False.
DJANGO_DEBUG=True

# 쉼표 구분. DEBUG=True 면 비워 둬도 * 로 동작한다.
ALLOWED_HOSTS=

# 웹 클라이언트가 생기면 채운다. 예: https://admin.highfive.app
CORS_ALLOWED_ORIGINS=

# PostgreSQL. 로컬 Docker 기본값이며 운영에서는 RDS 접속값으로 교체한다.
DB_NAME=highfive
DB_USER=highfive
DB_PASSWORD=highfive-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
REDIS_URL=redis://127.0.0.1:6379/1

# Firebase 서비스 계정 키. server/ 기준 상대 경로로 적는다.
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 으로 내려받는다.
# ⚠️ 관리자 권한 키다. 저장소에 커밋하지 않는다(.gitignore 에 이미 걸려 있다).
FIREBASE_CREDENTIALS=secrets/firebase-adminsdk.json

# 운동 경로·심박 원본용 비공개 S3 호환 저장소. 로컬 MinIO 예시:
# `docker compose up -d` 후 아래 주석을 풀면 MinIO를 사용한다.
# 서버가 MinIO에 접근하는 내부 주소. dev.py 기본값은 localhost:9000이다.
# S3_ENDPOINT_URL=http://localhost:9000
# Android 실단말은 dev.py가 adb reverse로 로컬 MinIO에 연결한다.
# 개발에서는 API 요청 호스트에서 MinIO의 공개 주소를 자동 생성한다.
# 운영에서만 실제 S3/CDN 공개 endpoint를 지정한다.
# S3_PUBLIC_ENDPOINT_URL=https://s3.ap-northeast-2.amazonaws.com
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NAME=highfive-private
# S3_REGION=ap-northeast-2
# WORKOUT_UPLOAD_MAX_BYTES=26214400

# dev.py가 실행할 Django 개발 서버 주소. 실단말 테스트를 위해
# 기본값은 같은 네트워크에서 접근 가능한 0.0.0.0:8000이다.
# DEV_SERVER_HOST=0.0.0.0
# DEV_SERVER_PORT=8000
